# Copy to .env (gitignored).
# The folder holding retail.duckdb, seed/, legacy-engine/ and the weekly exports.
RETAIL_DATA_DIR=/path/to/retail-data

# The config with real store names and the colour split list. Keep it in the data
# folder, outside the repo. Without this line, the app uses config/config.example.json.
RETAIL_CONFIG=/path/to/retail-data/config.json
